# Base de datos (local o Supabase).
# Supabase: usar la cadena del "Session pooler" (host aws-...pooler.supabase.com, puerto 5432).
# No hace falta ?sslmode=require: el SSL se configura solo cuando la base no es local.
DATABASE_URL=postgresql://sigi_user:clave@localhost:5432/sigi_bkr
DB_POOL_MAX=10

# Servidor (en Render NO definir PORT: lo inyecta la plataforma)
PORT=3000
NODE_ENV=development

# Dominios habilitados en producción (separados por coma, sin barra final).
# Ej.: CORS_ORIGINS=https://tu-usuario.github.io    '*' sólo para desarrollo.
CORS_ORIGINS=*

# Imágenes en Supabase Storage (si se dejan vacías, se guardan en public/uploads).
# SUPABASE_SECRET_KEY = "secret key" (o la service_role legacy). NUNCA va en el front.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=insumos

# Alertas por correo (opcional: si no se configura, la alerta queda sólo en el log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_DESTINATARIO=
